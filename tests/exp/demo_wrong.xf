#test {
// EXP `wrong` 视频演示：反事实守卫
// wrong <条件> 给程序装一个守卫：条件在运行期为"真"时，程序亲眼看见了一个
// "不该出现的结果"，于是随机拨动 1 到 5，让这个结果消失，然后带着新值继续。
// 拨的是"根"（读不到别的变量的叶子），派生变量沿赋值链重算，关系保持一致。

    fn main() {
        // 第 1 幕：最简单的一次逃避
        print("== 1. 这个结果不该存在：随机拨 1..5 ==")
        int x = 10
        print(x)          // 10：此刻这个事实还成立
        wrong x == 10
        print(x)          // 11..15：条件为真，x 被随机加 1..5
        print("--")

        // 第 2 幕：拨的是根，派生链跟着重算
        print("== 2. 拨根不拨结果：z = x + y 一直成立 ==")
        int a = 10
        int b = 20
        int z = a + b
        print(z)          // 30
        wrong z == 30
        print(a)          // 11..15：根 a 被随机加 1..5
        print(b)          // 20：b 没参与本次逃避
        print(z)          // 31..35：z 沿 a + b 重算，关系仍然成立
        print("--")

        // 第 3 幕：守卫是持久的 —— 以后每次复现都会被拦下
        print("== 3. 守卫一直在：每次复现都被赶走 ==")
        int c = 5
        wrong c == 5
        print(c)          // 6..10
        c = 5              // 又归于 5
        print(c)          // 6..10：守卫再次触发
        print("--")

        // 第 4 幕：多个守卫会把值一路推走
        print("== 4. 三个守卫：10 一路被推走 ==")
        int d = 10
        wrong d == 10
        print(d)          // 11..15
        wrong d == 11
        print(d)          // 12..16
        wrong d == 12
        print(d)          // 13..17
        print("--")

        // 第 5 幕：关系型条件直接跳到边界
        print("== 5. 关系边界：一步跨过去 ==")
        int e = 3
        wrong e < 8
        print(e)          // 8：直接跳到边界 8
        print("--")

        // 第 6 幕：条件为假时守卫什么都不做
        print("== 6. 条件为假：守卫袖手旁观 ==")
        int f = 100
        wrong f == 7
        print(f)          // 100：一个单位也不拨
        print("--")
        print("== done ==")
    }
}
