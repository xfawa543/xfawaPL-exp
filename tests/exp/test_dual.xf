#test {
// EXP `dual`：把一个独立存在分裂成两个独立存在的自身 (docs/exp/dual.md)
// d1 出生：dual x = 10 之后两个自己都是 10（x 与 x[1]）
// d2 独立演化：x = x+1 只改原身，x[1] = x[1]+5 只改分身 → 11 / 15
// d3 继续分裂演化：分身翻倍、原身减 3 → 30 / 8；x[0] 就是原身
// d4 dual x（不带值）：按当前值分裂，两个自己再各自独立增长 → 7 7 8 10
// d5 浮点：dual 支持小数分裂与独立演化 → 1.5 / 4.0
// d6 布尔：dual 支持真假分裂；flag[1] = false 只改分身 → 1 1 0 1

    fn main() {
        // d1 birth: one existence becomes two identical selves
        dual x = 10
        print(x)
        print(x[1])
        print("d1")

        // d2 independence: each self evolves on its own
        x = x + 1
        x[1] = x[1] + 5
        print(x)
        print(x[1])
        print("d2")

        // d3 keep diverging; x[0] is the original self
        x[1] = x[1] * 2
        x = x - 3
        print(x[1])
        print(x)
        print(x[0])
        print("d3")

        // d4 split an existing variable (no value) at its current value
        y = 7
        dual y
        print(y)
        print(y[1])
        y = y + 1
        y[1] = y[1] + 3
        print(y)
        print(y[1])
        print("d4")

        // d5 float
        val = 3.5
        dual val = 1.5
        print(val)
        print(val[1])
        val[1] = val[1] + 2.5
        print(val[1])
        print("d5")

        // d6 bool
        flag = true
        dual flag
        print(flag)
        print(flag[1])
        flag[1] = false
        print(flag[1])
        print(flag)
        print("d6")
    }
}