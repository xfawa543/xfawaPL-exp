#test {
// EXP `fate` 视频演示：设定命运，反抗后被不完美地拉回
// fate x = 100 给 x 设定命运值并立即生效：
//   每次离开命运值的赋值，都会被“中点折半”拉回，永远不等于命运值；
//   每一轮恢复的最高结果成为持久底数，之后任何恢复都不得低于底数；
//   普通变量完全不受影响。

    fn main() {
        // 第 1 幕：命运值出生即有，反抗被折半拉回
        print("== 1. 设定命运，反抗后拉回 ==")
        fate a = 100
        print(a)          // 100（命运值）
        a = 20            // 反抗！
        print(a)          // 60（20 + (100-20)/2）
        print("--")

        // 第 2 幕：多次反抗 —— 一步步逼近命运值，但永远不等于 100
        print("== 2. 多次反抗，步步逼近 ==")
        fate b = 100
        b = 20
        print(b)          // 60
        b = 10
        print(b)          // 80
        b = 20
        print(b)          // 90
        b = 30
        print(b)          // 95
        print("--")

        // 第 3 幕：底数只升不降 —— 深反抗也掉不下去
        print("== 3. 底数闸门 ==")
        fate c = 100
        c = 20
        print(c)          // 60（底数 60）
        c = 10
        print(c)          // 80（底数 80）
        c = -100          // 深反抗
        print(c)          // 90（不低于底数 80）
        print("--")

        // 第 4 幕：普通变量不受命运机制影响
        print("== 4. 普通变量不受影响 ==")
        plastic = 500
        plastic = 20
        plastic = -7
        print(plastic)    // -7
    }
}