#test {
// 视频演示：deja（偷未来 / 预感）+ fate（命运）
// 目的：用简单、可读的输出覆盖整体语义，方便录屏讲解。

    fn need() {
        return 3
    }

    fn main() {
        // ==================== 1. deja 偷未来：赋值在后，读取在前 ====================
        // deja x 之后、真正赋值之前，读 x 得到的是未来的常量 42
        deja x
        print(x)              // 预感：42
        x = 42                // 未来赋值照常执行一次
        print("---- deja-1 done ----")

        // ==================== 2. deja 常量表达式未来 ====================
        // 未来是能用常量折叠算出来的表达式也能预感：100 - 1 → 99
        deja y
        print(y)              // 预感：99
        y = 100 - 1
        print("---- deja-2 done ----")

        // ==================== 3. deja 未来不是常量 → 预感失败 ====================
        // 未来的赋值是函数调用（不是常量），无法预感：
        // 编译时给出 [deja] warning，程序按普通语义继续
        deja z
        z = need()
        print(z)              // 3（正常值，不是预感）
        print("---- deja-3 done ----")

        // ==================== 4. fate 设定命运 + 第一次反抗 ====================
        // fate a = 100：a 的命运值是 100，出生时立即可见
        fate a = 100
        print(a)              // 100（命运值）
        a = 20                // 反抗！直接写 20
        print(a)              // 60：被向命运值"中点折半"拉回：20 + (100-20)/2
        print("---- fate-1 done ----")

        // ==================== 5. fate 多次反抗，逐步逼近但不等于命运值 ====================
        // 每次反抗都被拉回，且越来越接近 100；每次恢复成为新底数
        fate b = 100
        b = 20
        print(b)              // 60
        b = 10
        print(b)              // 80
        b = 20
        print(b)              // 90
        b = 30
        print(b)              // 95（逼近 100，但永远不等于 100）
        print("---- fate-2 done ----")

        // ==================== 6. 普通变量不受 fate 影响 ====================
        free = 500
        free = 20             // 直接变成 20，没有任何拉回
        print(free)           // 20
        print("---- fate-3 done ----")
    }
}