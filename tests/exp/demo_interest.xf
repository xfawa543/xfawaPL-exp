#test {

// 读一次，长一点
// ¥[利率] x = v   单利：每次读取固定 + 本金×利率（本金在该条规则诞生时冻结）
// $[利率] x = v   复利：每次读取 x = x + x×利率（利滚利）
// ¥x = v          不带利率 → 默认 0.0001
// 关键：每次读取"先返回当前值，再结算"；同一表达式里读几次就结算几次。
// 利息变量是浮点，打印带 6 位小数。


    fn main() {
        // 单利 —— 读得越多，涨得越多（每次固定 +1）
        print("== 1. 单利：本金 10，利率 10%，每次固定 +1 ==")
        ¥[0.1]a = 10
        print(a)         // 10.000000（先返回 10，结算为 11）
        print(a)         // 11.000000（返回 11，结算为 12）
        print(a)         // 12.000000
        print("--")


        // 同一个表达式里读三次 → 结算三次
        print("== 2. 表达式中连续读取 ==")
        ¥[0.1]b = 10
        print(b + b + b) // 10 + 11 + 12 = 33.000000
        print(b)         // 13.000000（三次结算后）
        print("--")


        // 复利 —— 利息也生息
        print("== 3. 复利：利滚利 ==")
        $[0.1]c = 10
        print(c)         // 10.000000（结算为 11）
        print(c)         // 11.000000（结算为 12.1）
        print(c)         // 12.100000
        print("--")


        // 默认利率 0.0001
        print("== 4. 不带利率：默认 0.0001 ==")
        ¥d = 100
        print(d)         // 100.000000
        print(d)         // 100.010002（+0.01）
        print("--")


        // 同名规则按声明顺序叠加
        print("== 5. 三条规则叠加：+1、+1、再 ×1.1 ==")
        ¥[0.1]m = 10
        ¥[0.1]m = 10
        $[0.1]m = 10
        print(m)         // 10.000000（读取前）
        print(m)         // 13.200000（10 +1 +1 再 ×1.1）
        print(m)         // 16.720000（13.2 +1 +1 再 ×1.1）
        print("--")


        // 普通赋值后，已挂上的规则依旧生效
        print("== 6. 普通赋值只改值，不改规则 ==")
        ¥[0.1]e = 10
        e = 20
        print(e)         // 20.000000
        print(e)         // 21.000000
    }
}