#test {
// EXP `fu*k` 视频演示：列表合并 —— 各取随机一半拼一张新列表
// A fu*k B：从 A 随机取 floor(长度/2) 个互不重复元素，
//           从 B 同样随机取 floor(长度/2) 个元素，拼接成一张新列表。
// 每次运行结果都可能不同，但一定落在合法的取值集合里。
// 两边的元素类型必须一致（int / long / string；float 暂不支持）。

    fn main() {
        // 第 1 幕：两字面量各取 2 个 → 新列表长 4
        print("== 1. [1,2,3,4] fu*k [10,20,30,40]：每边取 2 个 ==")
        c = [1,2,3,4] fu*k [10,20,30,40]
        print(c[0])      // 来自 {1,2,3,4}
        print(c[1])      // 来自 {1,2,3,4}
        print(c[2])      // 来自 {10,20,30,40}
        print(c[3])      // 来自 {10,20,30,40}
        print("--")

        // 第 2 幕：变量与区间 ➜ 左边变量右边区间 [1...4]
        print("== 2. [1...4] fu*k [10,20,30]：取 2 + 1 = 3 个 ==")
        b = [1...4]
        d = [10,20,30]
        e = b fu*k d
        print(e[0])      // 来自 {1,2,3,4}
        print(e[1])      // 来自 {1,2,3,4}
        print(e[2])      // 来自 {10,20,30}
        print("--")

        // 第 3 幕：奇数长度按 floor 取一半（1 + 1 = 2）
        print("== 3. 奇数长度：[1,2,3] ➜ 取 1；[40,50] ➜ 取 1 ==")
        g = [1,2,3] fu*k [40,50]
        print(g[0])      // 来自 {1,2,3}
        print(g[1])      // 来自 {40,50}
        print("--")

        // 第 4 幕：字符串列表（类型一致即可）
        print("== 4. 字符串列表各取一半 ==")
        s = ["aa","bb","cc"] fu*k ["xx","yy","zz"]
        print(s[0])      // 来自 {aa,bb,cc}
        print(s[1])      // 来自 {xx,yy,zz}
    }
}