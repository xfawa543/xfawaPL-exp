#test {
// EXP `envy` 视频演示：嫉妒比自己更好的人
// envy a b 让 a（嫉妒者）盯着 b（目标）比：
//   差距 ≤ a 自身         → 超越：a = b + 1（努把力就能超过）
//   a < 差距 ≤ 2×a        → 成为：a = b（我想变成他那样）
//   差距 > 2×a（绝望）     → 摧毁：b = a - 1（我得不到，你也别想有）
//   a 已经不弱于 b / 维度不可比 → 完全不动（可能给 [envy] 警告）
// 一次 envy 只做一步，结果完全由当时的差距决定。

    fn main() {
        // 第 1 幕：超越 —— 差距还不够悬殊（40 < 差距 60？ 不，差距 ≤ 自身就超越）
        print("== 1. 超越：差距小，一跃而上 ==")
        a = 50
        b = 100          // 差距 = 50 ≤ 自身 50 → 超越
        envy a b
        print(a)         // 101（a = b + 1）
        print(b)         // 100（目标不变）
        print("--")

        // 第 2 幕：成为 —— 差距中等，直接复刻
        print("== 2. 成为：我想变成他那样 ==")
        x = 30
        y = 70           // 差距 = 40，自身 30 < 40 ≤ 60 → 成为
        envy x y
        print(x)         // 70（复制目标）
        print(y)         // 70
        print("--")

        // 第 3 幕：摧毁 —— 绝望差距，拉他下水
        print("== 3. 摧毁：我得不到，你也别想有 ==")
        poor = 10
        rich = 100       // 差距 = 90 > 2×10 → 摧毁
        envy poor rich
        print(poor)      // 10（自己不变）
        print(rich)      // 9（目标被拉到自身之下：10 - 1）
        print("--")

        // 第 4 幕：自身不弱 / 平手 → 什么都别做
        print("== 4. 无嫉妒：自己已经更好（或平手）==")
        c = 100
        d = 50
        envy c d
        print(c)         // 100
        print(d)         // 50
        p = 60
        q = 60
        envy p q
        print(p)         // 60
        print(q)         // 60
        print("--")

        // 第 5 幕：维度不可比（字符串/跨类型）→ 原样 + [envy] 警告
        print("== 5. 不可比较：字符串之间没有高低维度 ==")
        s1 = "hello"
        s2 = "world"
        envy s1 s2
        print(s1)        // hello（原样）
        print(s2)        // world（原样）
        num = 5
        txt = "hi"
        envy num txt     // int vs 字符串 → 维度不同
        print(num)       // 5
        print(txt)       // hi
    }
}