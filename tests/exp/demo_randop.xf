#test {
// EXP `?!` 视频演示：命运随机的二元运算
// a ?! b 在运行时为 a、b 随机挑选一个"合法"的二元运算符来算：
//   整数 ?! 整数    → + - * % && ||（7 选 1，除比较类结果类型不合）
//   浮点 ?! 浮点    → + - * %（5 选 1）
//   布尔 ?! 布尔    → && ||（2 选 1）
//   整数 ?! 浮点    → 提升为浮点再随机，+ - * %（5 选 1）
//   字符串等无合法候选 → 退化为左操作数（编译期 warning）
// 每次运行结果未知，但永远落在合法候选集内 —— 语法恒成立，值却靠运气。

    fn main() {
        // 第 1 幕：整数 ?! 整数 —— 7 种候选，这轮碰上哪一个？
        print("== 1. 整数 ?! 整数（候选 + - * % && ||） ==")
        val_a = 6
        val_b = 2
        iter = 0
        while (iter < 6) {
            print(val_a ?! val_b)
            iter = iter + 1
        }
        print("--")

        // 第 2 幕：浮点 ?! 浮点 —— 5 种候选，小数比较难猜
        print("== 2. 浮点 ?! 浮点（候选 + - * %） ==")
        fl_a = 6.5
        fl_b = 2.0
        iter = 0
        while (iter < 6) {
            print(fl_a ?! fl_b)
            iter = iter + 1
        }
        print("--")

        // 第 3 幕：布尔 ?! 布尔 —— 非真即假，只掷两面的硬币
        print("== 3. 布尔 ?! 布尔（候选 && ||） ==")
        bl_t = true
        bl_f = false
        iter = 0
        while (iter < 10) {
            print(bl_t ?! bl_f)
            iter = iter + 1
        }
        print("--")

        // 第 4 幕：整数 × 浮点 —— 先提升为浮点再随机
        print("== 4. 混搭 3 ?! 2.5（提升为浮点） ==")
        iter = 0
        while (iter < 6) {
            print(3 ?! 2.5)
            iter = iter + 1
        }
        print("--")

        // 第 5 幕：没有合法候选 → 退化 = 永远取左边的值
        print("== 5. 字符串参与 = 退化 ==")
        st1 = "abc"
        numv = 5
        res_s = st1 ?! numv
        print(res_s)           // "abc"（每一次都是）
        print(numv ?! st1)     // 5（每一次都是）
    }
}