#test {
    fn main() {
        // f1 两字面量各取一半（2+2=4 个随机元素）
        c = [1,2,3,4] fu*k [5,6,7,8]
        print(c[0])
        print(c[1])
        print(c[2])
        print(c[3])
        print("f1")

        // f2 变量与区间（2+1=3 个）
        b = [1...4]
        d = [10,20,30]
        e = b fu*k d
        print(e[0])
        print(e[1])
        print(e[2])
        print("f2")

        // f3 奇数长度各自取 floor(长度/2)（1+1=2 个）
        g = [1,2,3] fu*k [40,50]
        print(g[0])
        print(g[1])
        print("f3")

        // f4 字符串数组（2+2=4 个）
        s = ["aa","bb","cc","dd"] fu*k ["ee","ff","gg","hh"]
        print(s[0])
        print(s[1])
        print(s[2])
        print(s[3])
        print("f4")

        // f5 长整数组（1+1=2 个）
        l1 = [10000000000,20000000000]
        l2 = [30000000000,40000000000]
        l = l1 fu*k l2
        print(l[0])
        print(l[1])
        print("f5")
    }
}