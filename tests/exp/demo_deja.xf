#test {
// EXP `deja` 视频演示：偷未来（预感）
// deja x 能把“未来第一个常量赋值”提前变得可见：
//   赋值在后、读取在前 → 读到的是预感到的未来值；
//   真实赋值照常执行一次（不搬走、不重复）；
//   未来不是常量（变量 / 函数调用）→ 预感失败 + warning，保持常规语义。

    fn helper() {
        return 7
    }

    fn main() {
        // 第 1 幕：基本预感 —— 赋值在后，读取在前
        print("== 1. 预感：看穿未来 ==")
        deja x
        print(x)          // 42（预感到未来的 x = 42）
        x = 42            // 真实赋值
        print(x)          // 42
        print("--")

        // 第 2 幕：无副作用 —— 未来赋值照常执行一次
        print("== 2. 未来赋值照常执行 ==")
        deja m
        print(m * 2)      // 200（预感值 100 在真实赋值前被使用）
        m = 100           // 真实赋值只执行这一次
        print(m)          // 100
        print("--")

        // 第 3 幕：非常量未来 → 预感失败 + warning
        print("== 3. 非常量未来 = 预感失败 ==")
        a = 1
        deja b
        b = a             // 未来是变量 → 不可预感
        print(b)          // 1（正常值）
    }
}