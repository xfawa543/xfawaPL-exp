#test {
// EXP `a <->[K] b` 视频演示：可逆反应
// 左边多出来的会往右边走，右边多出来的会往左边走，一步走完差额/K。
// 反应不创造也不销毁：a + b 永远不变，平衡点附近改成随机游走。

    fn main() {
        print("== 1. K = 1：一步走一半的差额 ==")
        int a = 10
        int b = 90
        a <->[1] b
        print(a)                // 30：差 40 的一半
        print(b)                // 70：正好挪过去 20
        print("--")

        print("== 2. 再反应一次，继续靠近 ==")
        a <->[1] b
        print(a)                // 40
        print(b)                // 60
        print("--")

        print("== 3. 总和守恒 ==")
        a <->[1] b
        print(a)                // 45
        print(b)                // 55
        print(a + b)            // 100：一分不多，一分不少
        print("--")

        print("== 4. K = 2：只走五分之一，平衡点也会落在分数上 ==")
        int m = 0
        int n = 100
        m <->[2] n
        print(m)                // 16：差 33 的五分之一
        print(n)                // 84
        m <->[2] n
        print(m)                // 24
        print(n)                // 76
        m <->[2] n
        print(m)                // 28
        print(n)                // 72
        print(m + n)            // 100
        print("--")

        print("== 5. 平衡之后原地游走 ==")
        int x = 1
        int y = 1
        x <->[3] y              // 两边一样，差额 0，什么也不发生
        print(x)                // 1
        print(y)                // 1
        print("== done ==")
    }
}
