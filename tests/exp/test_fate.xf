#test {
    // t1 基础示例：命运值出生时立即使用；反抗后被以“中点折半”方式不完美地拉回
    // t2 多次反抗：恢复结果逐步接近命运值（60 → 80 → 90 → 95），每一轮都是新底数
    // t3 底数闸门：深反抗也不能掉到底数以下；恢复结果成为新底数、底数只升不降
    // t4 普通变量不受 fate 影响
    // t5 恰好命中命运值：不动、不产生位移
    // t6 非整数命运值：退化为普通赋值（warning），不破坏正常语义

    fn main() {
        // t1：命运 e100 / 反抗 20 → 第一次恢复 60
        fate a = 100
        print("t1")
        print(a)          // 100（命运值）
        a = 20            // 反抗！
        print(a)          // 60（朝命运值方向折半：20 + (100-20)/2）
        print("t1done")

        // t2：多次反抗递进接近命运值 100（60 → 80 → 90 → 95，永远不等于 100）。
        //     反抗 20 → 60（新底数 60）；反抗 10 → 底数抬到 80；再反抗 20 →
        //     只会被抬到 90（同幅度反抗在底数抬升后随之抬升）；反抗 30 → 95。
        fate b = 100
        b = 20
        print(b)          // 60
        b = 10
        print(b)          // 80
        b = 20
        print(b)          // 90
        b = 30
        print(b)          // 95
        print("t2done")

        // t3：每一轮恢复结果成为新的底数（60 → 80），随后深反抗 -100
        //     也绝不能掉到底数 80 以下（恢复为 90，并成为新的底数 90）
        fate c = 100
        c = 20
        print(c)          // 60（新底数 60）
        c = 10
        print(c)          // 80（新底数 80）
        c = -100          // 深反抗：mid = 0，低于底数 80 → 从底数向命运值折半修复
        print(c)          // 90（不低于底数；90 成为新底数）
        print("t3done")

        // t4：普通变量完全不参与命运机制
        plastic = 500
        plastic = 20
        plastic = -7
        print(plastic)    // -7（无命运恢复）
        n1 = 1
        n1 = 2
        print(n1)         // 2
        print("t4done")

        // t5：恰好命中命运值不触发恢复，也不产生位移
        fate d = 7
        d = 7
        print(d)          // 7
        d = 9
        print(d)          // 8（7 + (9-7)/2）
        print("t5done")

        // t6：非整数命运值（字符串）退化为普通赋值（[fate] warning）
        fate s = "hi"
        print(s)          // hi
        print("t6done")
    }
}