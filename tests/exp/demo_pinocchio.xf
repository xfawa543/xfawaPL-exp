#test {
// EXP `pinocchio` 视频演示：匹诺曹悖论（投稿原文）
// 匹诺曹说："我的鼻子将会变长"。
//   命题为真 → 鼻子变长：a = a + 1
//   命题为假 → 鼻子变短：a = a - 1
//   a 的初始值是 2。
// 命题的真假取决于鼻子当前的长度；而每次变长/变短，
// 又会反过来改写命题下一轮的真假 —— 这就是自指反馈环：
//   真话让鼻子长，鼻子长了那句话又变成假话，于是鼻子又缩回去……

    fn main() {
        // 第 1 幕：真、假、真、假 —— 鼻子在 2 和 3 之间横跳
        print("== 1. 自指悖论：鼻子在 2 和 3 之间横跳 ==")
        print("a 的初始值是 2")
        a = 2
        pinocchio (a < 3) {        // 命题：我还要变长（鼻子还不到 3）
            a = a + 1              // 真 → 鼻子变长
            print(a)
        } else {
            a = a - 1              // 假 → 鼻子变短
            print(a)
        }
        print("--")

        // 第 2 幕：命题恒真的话，鼻子只会一直长，停不下来
        print("== 2. 恒真的话：鼻子只会长，停不下来（limit: 5） ==")
        a = 2
        pinocchio (a >= 2) {       // 命题：鼻子从不会短回去
            a = a + 1              // 真 → 每次变长
            print(a)
        } else {
            a = a - 1
        } limit: 5
    }
}