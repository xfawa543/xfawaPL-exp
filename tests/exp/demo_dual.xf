#test {
// EXP `dual` 视频演示：一个存在，分裂成两个独立存在的自身
// dual x = v 让 x 变成"双生变量"：
//   x / x[0] = 原身（分裂前那一个自己，行为完全不变）
//   x[1]     = 分身（第二个自己，出生时与原身同值）
// 之后 x = v 只改原身，x[1] = v 只改分身 —— 两个自己各自独立演化。
// 也支持 dual x（不带值）：按"当前值"把已存在的变量分裂成两个。

    fn main() {
        // 第 1 幕：出生 —— 两个自己同值
        print("== 1. 出生：一个存在变成两个相同的自己 ==")
        dual x = 10
        print(x)         // 10（原身）
        print(x[1])      // 10（分身，出生瞬间与原身相同）
        print("--")

        // 第 2 幕：独立演化 —— 互不打扰
        print("== 2. 各自人生：这一刀只落在自己身上 ==")
        x = x + 1        // 只改原身
        x[1] = x[1] + 5  // 只改分身
        print(x)         // 11
        print(x[1])      // 15
        print("--")

        // 第 3 幕：x[0] 就是原身本人
        print("== 3. x[0] 与 x 是同一个自己 ==")
        x[1] = x[1] * 2  // 分身 15 → 30
        x = x + 4        // 原身 11 → 15
        print(x[1])      // 30
        print(x)         // 15
        print(x[0])      // 15（x[0] 就是原身）
        print("--")

        // 第 4 幕：分裂已存在的变量（不带值，按当前值出生）
        print("== 4. dual 不带值：把现在的自己一分为二 ==")
        y = 7
        dual y
        print(y)         // 7（原身）
        print(y[1])      // 7（分身出生值 = 当前值）
        y = y + 1        // 原身 8
        y[1] = y[1] + 3  // 分身 10
        print(y)         // 8
        print(y[1])      // 10
        print("--")

        // 第 5 幕：浮点也能分裂
        print("== 5. 浮点双生 ==")
        dual dec = 1.5
        print(dec)         // 1.500000
        print(dec[1])      // 1.500000
        dec[1] = dec[1] + 2.5
        print(dec[1])      // 4.000000
        print("--")

        // 第 6 幕：布尔也能分裂
        print("== 6. 布尔双生 ==")
        flag = true
        dual flag
        print(flag)      // 1
        print(flag[1])   // 1
        flag[1] = false  // 只改分身
        print(flag[1])   // 0
        print(flag)      // 1（原身不动）
    }
}