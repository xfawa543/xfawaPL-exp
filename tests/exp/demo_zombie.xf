#test {
// EXP `zombie` 视频演示：算术瘟疫
// zombie x 让 x 感染。从此它参与的算术运算不再按数学算：
// 结果取"最左边那个带瘟疫的值"，并且运算里出现的每个变量都永久变成感染者。
// 注意：被传染不等于值被改写 —— q 只是生病了，它的值还是 3。

    fn clean(v) {
        // 第五幕：瘟疫不跨函数 —— 参数收到的是普通值
        print("== 5. 瘟疫不跨函数：参数是干净的 ==")
        print(v)          // 7：函数参数看不到调用者的感染状态
        int local = 100
        zombie local
        print(local)      // 100：本函数里的病人，结果恒等于自己
        print("--")
    }

    fn main() {
        // 第 1 幕：感染一个变量，然后做加法
        print("== 1. 生病的数字和干净的数字相加 ==")
        int a = 1
        int b = 2
        zombie a
        int c = a + b
        print(c)          // 1：结果不是 3，而是最左的病人 a
        print(b)          // 2：b 只是"接触"了一下，值没变
        print(a)          // 1：a 永远是 1
        print("--")

        // 第 2 幕：传染是永久的、且沿表达式扩散
        print("== 2. 传染：运算里每个人都生病 ==")
        int p = 10
        int q = 3
        zombie p
        int r = p + q
        print(r)          // 10
        int s = q - p
        print(s)          // 3：现在最左的病人是 q 自己，q - p 恒等于 q
        int t = p * p
        print(t)          // 10：病人和自己相乘，还是自己
        print(q)          // 3：q 已经感染，但值一直是 3
        print("--")

        // 第 3 幕：复制也会传染
        print("== 3. 复制传染：抄一份就够 ==")
        int u = 5
        int w = u
        print(w)          // 5：值照抄，w 从此也带病
        print("--")

        // 第 4 幕：比较和逻辑不传染
        print("== 4. 比较与逻辑不传染 ==")
        int m = 4
        int n = 9
        print(m < n)      // 1：比较照常算，n 不会因此生病
        print(n)          // 9
        print("--")

        clean(7)
        print("== done ==")
    }
}
